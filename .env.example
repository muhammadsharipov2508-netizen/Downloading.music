# ============================================
# VASO DOWNLOADER - Environment Configuration
# Copy this file to .env and update values
# ============================================

# Server Port
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API Configuration
API_TIMEOUT=30000

# TikTok API Configuration (if using third-party service)
TIKTOK_API_KEY=your_tiktok_api_key_here
TIKTOK_API_SECRET=your_tiktok_api_secret_here

# Instagram API Configuration (if using third-party service)
INSTAGRAM_API_KEY=your_instagram_api_key_here
INSTAGRAM_API_SECRET=your_instagram_api_secret_here

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Download Configuration
MAX_VIDEO_SIZE=500MB
DOWNLOAD_TIMEOUT=60000
TEMP_STORAGE_PATH=./temp

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
